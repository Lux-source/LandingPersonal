---
import Icon from "./Icon.astro";
import { getContent, homePath, projectPath } from "@/i18n";
import type { Lang, Project } from "@/i18n";

interface Props {
	lang: Lang;
	project: Project;
	next?: Project;
}

const { lang, project, next } = Astro.props;
const t = getContent(lang);

const TONE: Record<string, string> = {
	sand: "bg-cream-100 text-ink dark:bg-night-raised dark:text-cream",
	terracotta: "bg-terracotta text-white",
	olive: "bg-olive text-white",
};
const ICON_TONE: Record<string, string> = {
	sand: "text-terracotta",
	terracotta: "text-white",
	olive: "text-white",
};
const LEARNED_DOT = ["bg-mustard", "bg-terracotta", "bg-olive"];

const hasLink = project.links.live || project.links.code || project.links.docs;
---

<article class="mx-auto max-w-[1280px] px-5 pb-4 sm:px-8 lg:px-16">
	<a
		href={`${homePath(lang)}#projects`}
		class="inline-flex min-h-[44px] items-center gap-2 text-[15px] font-semibold text-muted transition-colors hover:text-terracotta dark:text-cream/70"
	>
		<Icon name="arrow-left" class="h-[17px] w-[17px]" strokeWidth={2.2} />
		{t.projects.backToList}
	</a>

	<header data-entrance class="mt-4 flex flex-col gap-5">
		<div class="flex flex-wrap items-center gap-2.5">
			<span
				class:list={[
					"rounded-full px-3.5 py-1.5 text-[12px] font-bold uppercase tracking-wide",
					project.kindStyle === "live"
						? "bg-olive text-cream"
						: "bg-cream-100 text-muted dark:bg-night-raised dark:text-cream/75",
				]}>{project.kind}</span
			>
		</div>

		<h1
			class:list={[
				"max-w-[820px] font-display text-[44px] leading-[1.03] tracking-tight lg:text-[62px]",
				project.title.startsWith("[") && "text-placeholder",
			]}
		>
			{project.statement || project.title}
		</h1>

		<p
			class:list={[
				"max-w-[700px] text-lg leading-relaxed lg:text-[21px]",
				project.lead.startsWith("[") ? "text-placeholder" : "text-muted dark:text-cream/75",
			]}
		>
			{project.lead}
		</p>

		{
			hasLink && (
				<div class="mt-1 flex flex-wrap gap-3">
					{project.links.docs && (
						<a
							href={project.links.docs}
							target="_blank"
							rel="noopener noreferrer"
							class="flex min-h-[54px] items-center gap-2.5 rounded-full bg-terracotta px-7 text-[15px] font-bold text-white transition-transform hover:scale-[1.02]"
						>
							<Icon name="github" class="h-[17px] w-[17px]" strokeWidth={1.9} />
							{t.projects.docs}
						</a>
					)}
					{project.links.code && (
						<a
							href={project.links.code}
							target="_blank"
							rel="noopener noreferrer"
							class="flex min-h-[54px] items-center gap-2.5 rounded-full border border-line bg-white px-6 text-[15px] font-semibold text-ink dark:border-night-line dark:bg-night-surface dark:text-cream"
						>
							<Icon name="external" class="h-[17px] w-[17px]" strokeWidth={2} />
							{t.projects.source}
						</a>
					)}
					{project.links.live && (
						<a
							href={project.links.live}
							target="_blank"
							rel="noopener noreferrer"
							class="flex min-h-[54px] items-center gap-2.5 rounded-full border border-line bg-white px-6 text-[15px] font-semibold text-ink dark:border-night-line dark:bg-night-surface dark:text-cream"
						>
							<Icon name="external" class="h-[17px] w-[17px]" strokeWidth={2} />
							{t.projects.live}
						</a>
					)}
				</div>
			)
		}
	</header>

	<!-- architecture -->
	{
		project.architecture.length > 0 && (
			<section class="mt-11 rounded-[26px] border border-line bg-white p-7 sm:p-10 dark:border-night-line dark:bg-night-surface">
				<div class="mb-6 flex flex-wrap items-baseline gap-3.5">
					<h2 class="font-display text-[28px] tracking-tight lg:text-[32px]">
						{t.projects.howItWorks}
					</h2>
					{project.archSubtitle && <span class="text-[15px] text-faint">{project.archSubtitle}</span>}
				</div>

				<ol data-reveal-list="x" data-stagger="0.1" class="flex flex-col items-stretch gap-3 lg:flex-row">
					{project.architecture.map((step, index) => (
						<>
							<li
								class={`flex flex-1 flex-col items-center gap-2.5 rounded-[18px] p-6 text-center ${TONE[step.tone] ?? TONE.sand}`}
							>
								<Icon
									name={step.icon}
									class={`h-[34px] w-[34px] ${ICON_TONE[step.tone] ?? "text-terracotta"}`}
									strokeWidth={1.8}
								/>
								<span class="text-[17px] font-bold">{step.title}</span>
								<span class="text-sm leading-relaxed opacity-90">{step.body}</span>
							</li>
							{index < project.architecture.length - 1 && (
								<li class="flex shrink-0 items-center justify-center" aria-hidden="true">
									<Icon
										name="arrow-right"
										class="h-7 w-7 rotate-90 text-[#D8C4A8] lg:rotate-0"
										strokeWidth={2.6}
									/>
								</li>
							)}
						</>
					))}
				</ol>
			</section>
		)
	}

	<!-- why + learned -->
	<div class="mt-11 grid gap-4 lg:grid-cols-2">
		<section
			class="flex flex-col gap-3.5 rounded-[22px] border border-line bg-white p-7 sm:p-8 dark:border-night-line dark:bg-night-surface"
		>
			<h2 class="font-display text-[26px] tracking-tight lg:text-[30px]">{t.projects.whyTitle}</h2>
			<p
				class:list={[
					"text-base leading-relaxed",
					project.why.startsWith("[") ? "text-placeholder" : "text-muted dark:text-cream/75",
				]}
			>
				{project.why}
			</p>
		</section>

		<section
			class="flex flex-col gap-3.5 rounded-[22px] border border-line bg-white p-7 sm:p-8 dark:border-night-line dark:bg-night-surface"
		>
			<h2 class="font-display text-[26px] tracking-tight lg:text-[30px]">
				{t.projects.learnedTitle}
			</h2>
			<ul data-reveal-list="y" data-stagger="0.06" class="flex flex-col gap-2.5">
				{
					project.learned.map((item, index) => (
						<li class="flex items-start gap-3">
							<span
								class={`mt-2 h-2 w-2 shrink-0 rounded-full ${LEARNED_DOT[index % LEARNED_DOT.length]}`}
								aria-hidden="true"
							/>
							<span
								class:list={[
									"text-base leading-relaxed",
									item.startsWith("[") ? "text-placeholder" : "text-muted dark:text-cream/75",
								]}
							>
								{item}
							</span>
						</li>
					))
				}
			</ul>
		</section>
	</div>

	<!-- stack + image -->
	<div class:list={["mt-4 grid gap-4", project.image && "lg:grid-cols-[1fr_1.4fr]"]}>
		<section
			class="flex flex-col gap-4 rounded-[22px] bg-ink p-7 text-cream sm:p-8 dark:bg-night-surface"
		>
			<h2 class="font-display text-[26px] tracking-tight lg:text-[28px]">{t.projects.stackTitle}</h2>
			<ul data-reveal-list="y" data-stagger="0.03" class="flex flex-wrap gap-2">
				{
					project.stack.map((item) => (
						<li
							class:list={[
								"rounded-full px-4 py-2 text-sm",
								item.name.startsWith("[")
									? "border border-dashed border-white/25 font-semibold text-placeholder"
									: item.featured
										? "bg-mustard font-bold text-ink"
										: "border border-white/15 font-semibold text-cream",
							]}
						>
							{item.name}
						</li>
					))
				}
			</ul>
			{
				project.docsUrl && (
					<>
						<div class="h-px bg-white/10" />
						<div class="flex flex-col gap-1.5">
							<span class="text-[11.5px] font-bold uppercase tracking-[0.1em] text-faint">
								{t.projects.documentedIn}
							</span>
							<a
								href={project.docsUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 py-1 text-[17px] font-bold text-mustard"
							>
								{project.docsLabel}
								<Icon name="arrow-right" class="h-4 w-4" strokeWidth={2.2} />
							</a>
						</div>
					</>
				)
			}
		</section>

		{
			project.image && (
				<figure data-reveal class="overflow-hidden rounded-[22px] border border-line bg-white dark:border-night-line dark:bg-night-surface">
					<img src={project.image} alt={`${t.projects.galleryTitle}: ${project.title}`} loading="lazy" class="h-full w-full object-cover object-top" />
				</figure>
			)
		}
	</div>

	<!-- next project -->
	{
		next && (
			<a
				href={projectPath(lang, next.slug)}
				class="group mt-11 flex items-center justify-between gap-6 rounded-[22px] border border-line bg-white p-7 transition-shadow hover:shadow-lg hover:shadow-ink/5 sm:p-8 dark:border-night-line dark:bg-night-surface"
			>
				<span class="flex min-w-0 flex-col gap-1.5">
					<span class="text-[11.5px] font-bold uppercase tracking-[0.1em] text-faint">
						{t.projects.nextLabel}
					</span>
					<span
						class:list={[
							"font-display text-[28px] leading-tight tracking-tight lg:text-[32px]",
							next.title.startsWith("[") && "text-placeholder",
						]}
					>
						{next.title}
					</span>
					<span class="text-[15px] text-muted dark:text-cream/70">{next.kind}</span>
				</span>
				<span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-terracotta text-white transition-transform group-hover:translate-x-1">
					<Icon name="arrow-right" class="h-[22px] w-[22px]" strokeWidth={2.4} />
				</span>
			</a>
		)
	}
</article>
