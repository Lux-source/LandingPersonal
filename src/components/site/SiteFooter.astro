---
import { getContent } from "@/i18n";
import type { Lang } from "@/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
---

<footer
	class="mx-auto flex max-w-[1280px] flex-col gap-2 px-5 pb-10 pt-7 text-[13.5px] text-faint sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-16"
>
	<span>{t.footer.rights}</span>
	<span>{t.profile.location} · {t.profile.phone}</span>
</footer>
