---
import { getContent } from "@/i18n";
import type { Lang } from "@/i18n";

interface Props {
	lang: Lang;
	tone?: "mustard" | "olive";
	title?: string;
	body?: string;
	cta?: string;
}

const { lang, tone = "mustard", title, body, cta } = Astro.props;
const t = getContent(lang);

const isOlive = tone === "olive";
---

<section class="mx-auto max-w-[1280px] px-5 pt-16 sm:px-8 lg:px-16 lg:pt-20">
	<div
		class:list={[
			"flex flex-col gap-6 rounded-[26px] p-8 sm:p-11 lg:flex-row lg:items-center lg:justify-between lg:gap-10",
			isOlive ? "bg-olive" : "bg-mustard",
		]}
	>
		<div class="flex flex-col gap-2.5">
			<h2
				class:list={[
					"font-display text-[34px] leading-tight tracking-tight lg:text-[42px]",
					isOlive ? "text-cream" : "text-ink",
				]}
			>
				{title ?? t.contact.title}
			</h2>
			{
				(body ?? t.contact.body) && (
					<p class:list={["text-[17px] leading-relaxed", isOlive ? "text-cream/80" : "text-mustard-deep"]}>
						{body ?? t.contact.body}
					</p>
				)
			}
		</div>

		<div class="flex shrink-0 flex-col gap-3 sm:flex-row">
			<a
				href={`mailto:${t.profile.email}`}
				class:list={[
					"flex min-h-[54px] items-center justify-center rounded-full px-7 text-center text-[15px] font-bold transition-transform hover:scale-[1.02]",
					isOlive ? "bg-cream text-ink" : "bg-ink text-cream",
				]}
			>
				<span class="hidden sm:inline">{cta ?? t.contact.cta}</span>
				<span class="sm:hidden">{t.profile.email}</span>
			</a>
		</div>
	</div>
</section>
