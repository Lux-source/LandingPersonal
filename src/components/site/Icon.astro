---
interface Props {
	name: string;
	class?: string;
	strokeWidth?: number;
}

const { name, class: className = "h-5 w-5", strokeWidth = 1.9 } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{
		name === "boundary" && (
			<>
				<rect x="3" y="3" width="7" height="7" rx="1.5" />
				<rect x="14" y="14" width="7" height="7" rx="1.5" />
				<path d="M10 6.5h4a3 3 0 0 1 3 3V14" />
			</>
		)
	}
	{
		name === "document" && (
			<>
				<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
				<polyline points="14 3 14 8 19 8" />
				<line x1="9" y1="13" x2="15" y2="13" />
				<line x1="9" y1="17" x2="13" y2="17" />
			</>
		)
	}
	{
		name === "review" && (
			<>
				<polyline points="9 11 12 14 20 6" />
				<path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9" />
			</>
		)
	}
	{
		name === "bucket" && (
			<>
				<path d="M4 7l8-4 8 4v10l-8 4-8-4z" />
				<path d="M4 7l8 4 8-4M12 11v10" />
			</>
		)
	}
	{name === "bolt" && <polygon points="13 2 4 14 11 14 10 22 20 10 13 10" />}
	{
		name === "database" && (
			<>
				<ellipse cx="12" cy="6" rx="8" ry="3" />
				<path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6" />
				<path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" />
			</>
		)
	}
	{
		name === "chart" && (
			<>
				<rect x="3" y="4" width="18" height="15" rx="2" />
				<line x1="8" y1="15" x2="8" y2="11" />
				<line x1="12" y1="15" x2="12" y2="8" />
				<line x1="16" y1="15" x2="16" y2="12" />
			</>
		)
	}
	{
		name === "orbit" && (
			<>
				<circle cx="12" cy="12" r="7.5" />
				<path d="M12 4.5v15M4.5 12h15" />
				<ellipse cx="12" cy="12" rx="3.4" ry="7.5" />
			</>
		)
	}
	{
		name === "code" && (
			<>
				<polyline points="16 18 22 12 16 6" />
				<polyline points="8 6 2 12 8 18" />
				<line x1="13.5" y1="4" x2="10.5" y2="20" />
			</>
		)
	}
	{
		name === "cloud" && (
			<>
				<path d="M6.5 17a4 4 0 0 1 .8-7.9 6 6 0 0 1 11.4 1.6A3.6 3.6 0 0 1 18 17z" />
				<line x1="12" y1="14" x2="12" y2="21" />
				<polyline points="9 18 12 21 15 18" />
			</>
		)
	}
	{
		name === "briefcase" && (
			<>
				<rect x="3" y="7" width="18" height="13" rx="2" />
				<path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2" />
			</>
		)
	}
	{
		name === "mail" && (
			<>
				<rect x="3" y="5" width="18" height="14" rx="2" />
				<polyline points="3 7 12 13 21 7" />
			</>
		)
	}
	{
		name === "github" && (
			<path
				d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.2-1.5 6.2-6.7A5.2 5.2 0 0 0 19.9 4a4.9 4.9 0 0 0-.1-3.6s-1.1-.3-3.7 1.4a12.7 12.7 0 0 0-6.6 0C6.9.1 5.8.4 5.8.4A4.9 4.9 0 0 0 5.7 4a5.2 5.2 0 0 0-1.4 3.6c0 5.2 3.2 6.4 6.2 6.7a3.4 3.4 0 0 0-.9 2.6V21"
			/>
		)
	}
	{
		name === "linkedin" && (
			<>
				<rect x="3" y="3" width="18" height="18" rx="2" />
				<line x1="8" y1="11" x2="8" y2="16" />
				<circle cx="8" cy="7.6" r="0.6" fill="currentColor" />
				<path d="M12 16v-3a2 2 0 0 1 4 0v3" />
				<line x1="12" y1="11" x2="12" y2="16" />
			</>
		)
	}
	{
		name === "download" && (
			<>
				<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
				<polyline points="7 10 12 15 17 10" />
				<line x1="12" y1="15" x2="12" y2="3" />
			</>
		)
	}
	{
		name === "arrow-right" && (
			<>
				<line x1="5" y1="12" x2="19" y2="12" />
				<polyline points="13 6 19 12 13 18" />
			</>
		)
	}
	{
		name === "arrow-left" && (
			<>
				<line x1="19" y1="12" x2="5" y2="12" />
				<polyline points="11 6 5 12 11 18" />
			</>
		)
	}
	{
		name === "external" && (
			<>
				<line x1="7" y1="17" x2="17" y2="7" />
				<polyline points="9 7 17 7 17 15" />
			</>
		)
	}
	{
		name === "image" && (
			<>
				<rect x="3" y="4" width="18" height="16" rx="2" />
				<circle cx="8.5" cy="9.5" r="1.8" />
				<polyline points="21 16 15 10 5 20" />
			</>
		)
	}
</svg>
