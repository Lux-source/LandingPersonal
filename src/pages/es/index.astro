---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Hero from "@/components/site/Hero.astro";
import WorkSection from "@/components/site/WorkSection.astro";
import ProjectsSection from "@/components/site/ProjectsSection.astro";
import AboutSection from "@/components/site/AboutSection.astro";
import ContactSection from "@/components/site/ContactSection.astro";

const lang = "es" as const;
---

<SiteLayout lang={lang} page={{ kind: "home" }}>
	<Hero lang={lang} />
	<WorkSection lang={lang} />
	<ProjectsSection lang={lang} />
	<AboutSection lang={lang} />
	<ContactSection lang={lang} />
</SiteLayout>
