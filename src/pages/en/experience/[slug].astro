---
import SiteLayout from "@/layouts/SiteLayout.astro";
import ExperienceArticle from "@/components/site/ExperienceArticle.astro";
import ContactSection from "@/components/site/ContactSection.astro";
import { getContent, neighbours } from "@/i18n";
import type { GetStaticPaths } from "astro";

const lang = "en" as const;

export const getStaticPaths = (() => {
	return getContent("en").experience.map((job) => ({ params: { slug: job.slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const t = getContent(lang);
const job = t.experience.find((item) => item.slug === slug);

if (!job) {
	return Astro.redirect("/en/");
}

const { prev, next } = neighbours(t.experience, job.slug);
const title = `${job.role} — ${job.company} · ${t.profile.name}`;
---

<SiteLayout
	lang={lang}
	page={{ kind: "experience", slug: job.slug }}
	title={title}
	description={job.summary}
>
	<ExperienceArticle lang={lang} job={job} prev={prev} next={next} />
	<ContactSection lang={lang} title={t.work.ctaTitle} body="" cta={t.work.ctaButton} />
</SiteLayout>
